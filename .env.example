# Red Card API configuration. Copy to .env (read from the project root) or set
# the same variables in the environment. All variables are optional.

# --- Deployment --------------------------------------------------------------
# "production" refuses to start unless CARD_CORS_ORIGINS lists real origins.
# CARD_ENVIRONMENT=production
# Allowed browser origins, as a JSON list (not comma-separated).
# CARD_CORS_ORIGINS=["https://cards.example.org"]
# CARD_LOG_LEVEL=INFO

# --- Data and fonts (paths relative to the current directory, or absolute) ---
# CARD_TRANSLATIONS_JSON_PATH=data/Translations_with_sources.json
# CARD_FONTS_DIR=assets/fonts

# --- Print sheets -------------------------------------------------------------
# CARD_PAGE_SIZE=letter                  # letter or a4
# CARD_DEFAULT_CARDS_PER_PAGE=4          # grid mode: 4, 6, 8 or 12
# CARD_DEFAULT_FOLD_CARDS_PER_PAGE=4     # fold mode rows: 4, 5 or 6
# CARD_MARGIN_INCHES=0.5
# CARD_GUTTER_INCHES=0.25
# CARD_FOOTER_HEIGHT_INCHES=0.55

# --- Caching and limits -------------------------------------------------------
# CARD_JSON_CACHE_SECONDS=300            # Cache-Control for card/language/config JSON
# CARD_PDF_CACHE_SECONDS=3600            # Cache-Control for PDFs
# CARD_PDF_CACHE_SIZE=64                 # in-memory rendered PDFs kept (0 = off)
# CARD_RENDER_WORKERS=2                  # concurrent PDF renders
# CARD_RENDER_TIMEOUT_SECONDS=30
# CARD_RENDER_RATE_LIMIT_PER_MINUTE=20   # per client IP; 0 = off
